#!/usr/bin/env ruby
$stdout.sync = true
require_relative "../config/environment"
abort "Usage: bin/reconciliation_scheduler [--once]" unless ARGV.empty? || ARGV == [ "--once" ]
scheduler = ReconciliationScheduler.new(logger: ActiveSupport::Logger.new($stdout))
%w[TERM INT].each { |signal| Signal.trap(signal) { scheduler.stop } }
scheduler.run(once: ARGV.include?("--once"))
