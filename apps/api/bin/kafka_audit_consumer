#!/usr/bin/env ruby
$stdout.sync = true
require_relative "../config/environment"
abort "Usage: bin/kafka_audit_consumer [--once]" unless ARGV.empty? || ARGV == [ "--once" ]
consumer = KafkaAuditConsumer.new(logger: ActiveSupport::Logger.new($stdout))
%w[TERM INT].each { |signal| Signal.trap(signal) { consumer.stop } }
consumer.run(once: ARGV.include?("--once"))
