    {
      "id": 10,
      "type": "timeseries",
      "title": "Pending outbox events",
      "description": "Sidekiq acknowledgment means enqueue; Kafka acknowledgment means broker delivery. Neither proves browser receipt.",
      "datasource": {
        "type": "prometheus",
        "uid": "hammerfall-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (channel) (hammerfall_outbox_pending_events)",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
