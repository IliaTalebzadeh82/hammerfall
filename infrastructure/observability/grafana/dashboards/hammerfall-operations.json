{
  "uid": "hammerfall-operations",
  "title": "Hammerfall operations",
  "description": "Operational signals from passive telemetry; PostgreSQL alone decides auction outcomes.",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "hammerfall",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Auction and command health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Bid command rate",
      "description": "Requests and terminal outcomes. Replays are historical responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "hammerfall-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hammerfall_bid_requests_total[$__rate_interval]))",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bid command rate (continued)",
