# Local development only. Copy to .env; never use this password in production.
PGUSER=hammerfall
PGPASSWORD=hammerfall_local_only
PGHOST=127.0.0.1
PGPORT=5432
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
OUTBOX_PUBLISH_INTERVAL=1
OUTBOX_PUBLISH_BATCH_SIZE=100
KAFKA_PUBLISH_INTERVAL=1
KAFKA_PUBLISH_BATCH_SIZE=100
API_PORT=3001
WEB_PORT=3000
# Linux: match id -u and id -g if they differ from 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# Rails auction closer role; polling is not an exact closure SLA.
AUCTION_CLOSER_INTERVAL=1
AUCTION_CLOSER_BATCH_SIZE=100

# Read-only consistency sweep cadence. This is not a projection repair job.
RECONCILIATION_INTERVAL=60

# Retained client-command outcomes; cleanup is a manual bounded Rails task.
IDEMPOTENCY_RETENTION_DAYS=7
IDEMPOTENCY_PRUNE_BATCH_SIZE=1000

# Native Next.js transparent API rewrite (Compose uses http://api:3000).
API_ORIGIN=http://127.0.0.1:3001

# Browser-direct public WebSocket transport; no credentials. Build-time for Next.
NEXT_PUBLIC_CABLE_URL=ws://localhost:3001/cable
CABLE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CABLE_WORKER_THREADS=2
