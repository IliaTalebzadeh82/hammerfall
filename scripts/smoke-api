#!/usr/bin/env ruby
require "securerandom"
require "time"
require(File.exist?("./script/authenticated_smoke.rb") ? "./script/authenticated_smoke" : File.expand_path("../apps/api/script/authenticated_smoke", __dir__))

base = ENV.fetch("API_BASE_URL", "http://127.0.0.1:3001")
operator = AuthenticatedSmoke.new(base: base, login: "demo-operator")
bidder = AuthenticatedSmoke.new(base: base, login: "demo-alice")
now = Time.now.utc
auction = operator.expect(:post, "/api/v1/auctions", status: 201, body: {
  auction: { title: "Smoke auction #{now.iso8601}", starting_price: 10_000, minimum_increment: 500,
             starts_at: (now - 60).iso8601(6), ends_at: (now + 65).iso8601(6) }
}).fetch("data")
path = "/api/v1/auctions/#{auction.fetch('id')}"
operator.expect(:patch, path, status: 200, body: { auction: { description: "Authenticated HTTP smoke" } })
operator.expect(:post, "#{path}/schedule", status: 200)
operator.expect(:post, "#{path}/activate", status: 200)
[ 10_000, 11_000 ].each do |amount|
  bidder.expect(:post, "#{path}/bids", status: 201, body: { bid: { amount: amount } }, key: SecureRandom.uuid)
end
low = bidder.expect(:post, "#{path}/bids", status: 422, body: { bid: { amount: 10_500 } }, key: SecureRandom.uuid)
raise "Wrong low-bid error" unless low.dig("error", "code") == "bid_too_low" && low.dig("error", "details", "minimum_bid") == 11_500
active = bidder.expect(:get, path, status: 200).fetch("data")
raise "Incorrect active state" unless active.values_at("current_price", "current_leader_id", "winner_id") == [ 11_000, bidder.actor_id, nil ]
sleep([ Time.iso8601(active.fetch("ends_at")) - Time.now.utc + 0.1, 0 ].max)
closed = operator.expect(:post, "#{path}/close", status: 200).fetch("data")
raise "Incorrect winner" unless closed.values_at("status", "winner_id", "current_leader_id") == [ "closed", bidder.actor_id, bidder.actor_id ]
operator.expect(:post, "#{path}/close", status: 200)
rejected = bidder.expect(:post, "#{path}/bids", status: 422, body: { bid: { amount: 12_000 } }, key: SecureRandom.uuid)
raise "Wrong closed-auction error" unless rejected.dig("error", "code") == "invalid_auction_state"
history = bidder.expect(:get, "#{path}/bids", status: 200).fetch("data")
raise "History changed after rejection" unless history.map { |bid| bid.fetch("amount") } == [ 10_000, 11_000 ]
puts "Authenticated auction lifecycle smoke passed; retained auction #{auction.fetch('id')}."
