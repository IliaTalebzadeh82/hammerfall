#!/usr/bin/env ruby
require "json"
require "net/http"
require "time"

bases = ENV.fetch("API_BASE_URLS", ENV.fetch("API_BASE_URL", "http://127.0.0.1:3001")).split(",")
request = lambda do |method, path, body = nil, base = bases.first, expected = nil|
  uri = URI.join(base, path)
  message = { get: Net::HTTP::Get, post: Net::HTTP::Post, put: Net::HTTP::Put }.fetch(method).new(uri)
  if body
    message["Content-Type"] = "application/json"
    message.body = JSON.generate(body)
  end
  response = Net::HTTP.start(uri.host, uri.port, open_timeout: 5, read_timeout: 20) { |http| http.request(message) }
  status = response.code.to_i
  raise "Unexpected HTTP #{status}" unless expected ? status == expected : [ 200, 201 ].include?(status)
  JSON.parse(response.body)
end
users = %w[Alice Bob].map do |name|
  request.call(:post, "/api/v1/users", { user: { name: "Proxy smoke #{name} #{Time.now.utc.iso8601}" } }).dig("data", "id")
end
create = lambda do |scenario|
  now = Time.now.utc
  auction = request.call(:post, "/api/v1/auctions", {
    auction: { title: "Proxy smoke #{scenario} #{now.iso8601}", starting_price: 10_000, minimum_increment: 1_000,
               starts_at: (now - 60).iso8601, ends_at: (now + 3600).iso8601 }
  }).fetch("data")
  path = "/api/v1/auctions/#{auction.fetch('id')}"
  request.call(:post, "#{path}/schedule")
  request.call(:post, "#{path}/activate")
  path
end
maximum = lambda do |path, user, amount, base = bases.first|
  result = request.call(:put, "#{path}/maximum-bid", { maximum_bid: { bidder_id: user, maximum_amount: amount } }, base)
  raise "Private acknowledgement" unless result.fetch("data").keys.sort == %w[accepted auction_id bidder_id]
end
inspect_public = lambda do |path, price, leader, amounts|
  state = request.call(:get, path).fetch("data")
  history = request.call(:get, "#{path}/bids?limit=100").fetch("data")
  all = JSON.generate([ state, history ])
  raise "Private metadata leaked" if all.match?(/maximum_amount|priority_sequence|automatic|origin/)
  raise "Wrong price/leader" unless state.values_at("current_price", "current_leader_id", "winner_id") == [ price, leader, nil ]
  raise "Wrong history" unless history.map { |row| row.fetch("amount") } == amounts
  raise "Wrong sequences" unless history.map { |row| row.fetch("sequence") } == (1..history.length).to_a
  puts JSON.generate(auction: path, price: price, leader: leader, history: history.map { |row| row.slice("sequence", "amount", "bidder_id") })
end
path = create.call("A")
maximum.call(path, users[0], 30_000)
request.call(:post, "#{path}/bids", { bid: { bidder_id: users[1], amount: 20_000 } })
inspect_public.call(path, 21_000, users[0], [ 10_000, 20_000, 21_000 ])
path = create.call("B")
maximum.call(path, users[0], 30_000)
maximum.call(path, users[1], 40_000)
inspect_public.call(path, 31_000, users[1], [ 10_000, 30_000, 31_000 ])
path = create.call("C")
maximum.call(path, users[0], 30_000)
maximum.call(path, users[1], 30_000)
inspect_public.call(path, 30_000, users[0], [ 10_000, 30_000, 30_000 ])
path = create.call("D concurrent")
ready = Queue.new
start = Queue.new
threads = users.each_with_index.map do |user, index|
  Thread.new do
    ready << true
    raise "Barrier timed out" unless start.pop(timeout: 10)
    maximum.call(path, user, [ 30_000, 40_000 ][index], bases[index % bases.length])
  end
end
2.times { raise "Barrier timed out" unless ready.pop(timeout: 10) }
2.times { start << true }
threads.each(&:value)
inspect_public.call(path, 31_000, users[1], [ 10_000, 30_000, 31_000 ])
puts "Proxy smoke passed across #{bases.join(', ')}; labelled rows retained."
