#!/usr/bin/env ruby
require "json"
require "securerandom"
require "time"
require(File.exist?("./script/authenticated_smoke.rb") ? "./script/authenticated_smoke" : File.expand_path("../apps/api/script/authenticated_smoke", __dir__))

bases = ENV.fetch("API_BASE_URLS", ENV.fetch("API_BASE_URL", "http://127.0.0.1:3001")).split(",")
operator = AuthenticatedSmoke.new(base: bases.first, login: "demo-operator")
users = %w[demo-alice demo-bob].map { |login| AuthenticatedSmoke.new(base: bases.first, login: login) }
create = lambda do |scenario|
  now = Time.now.utc
  auction = operator.expect(:post, "/api/v1/auctions", status: 201, body: {
    auction: { title: "Proxy smoke #{scenario} #{now.iso8601}", starting_price: 10_000, minimum_increment: 1_000,
               starts_at: (now - 60).iso8601, ends_at: (now + 3600).iso8601 }
  }).fetch("data")
  path = "/api/v1/auctions/#{auction.fetch('id')}"
  operator.expect(:post, "#{path}/schedule", status: 200)
  operator.expect(:post, "#{path}/activate", status: 200)
  path
end
maximum = lambda do |path, user, amount, base = bases.first|
  result = user.expect(:put, "#{path}/maximum-bid", status: 200,
    body: { maximum_bid: { maximum_amount: amount } }, key: SecureRandom.uuid, base: base)
  raise "Private acknowledgement" unless result.fetch("data").keys.sort == %w[accepted auction_id bidder_id]
end
inspect_public = lambda do |path, price, leader, amounts|
  state = operator.expect(:get, path, status: 200).fetch("data")
  history = operator.expect(:get, "#{path}/bids?limit=100", status: 200).fetch("data")
  all = JSON.generate([ state, history ])
  raise "Private metadata leaked" if all.match?(/"(?:maximum_amount|priority_sequence|origin)"\s*:|"automatic"/)
  raise "Wrong price/leader" unless state.values_at("current_price", "current_leader_id", "winner_id") == [ price, leader, nil ]
  raise "Wrong history" unless history.map { |row| row.fetch("amount") } == amounts
  raise "Wrong sequences" unless history.map { |row| row.fetch("sequence") } == (1..history.length).to_a
  puts JSON.generate(auction: path, price: price, leader: leader, history: history.map { |row| row.slice("sequence", "amount", "bidder_id") })
end
path = create.call("A")
maximum.call(path, users[0], 30_000)
users[1].expect(:post, "#{path}/bids", status: 201, body: { bid: { amount: 20_000 } }, key: SecureRandom.uuid)
inspect_public.call(path, 21_000, users[0].actor_id, [ 10_000, 20_000, 21_000 ])
path = create.call("B")
maximum.call(path, users[0], 30_000)
maximum.call(path, users[1], 40_000)
inspect_public.call(path, 31_000, users[1].actor_id, [ 10_000, 30_000, 31_000 ])
path = create.call("C")
maximum.call(path, users[0], 30_000)
maximum.call(path, users[1], 30_000)
inspect_public.call(path, 30_000, users[0].actor_id, [ 10_000, 30_000, 30_000 ])
path = create.call("D concurrent")
ready = Queue.new
start = Queue.new
threads = users.each_with_index.map do |user, index|
  Thread.new do
    ready << true
    raise "Barrier timed out" unless start.pop(timeout: 10)
    maximum.call(path, user, [ 30_000, 40_000 ][index], bases[index % bases.length])
  end
end
2.times { raise "Barrier timed out" unless ready.pop(timeout: 10) }
2.times { start << true }
threads.each(&:value)
inspect_public.call(path, 31_000, users[1].actor_id, [ 10_000, 30_000, 31_000 ])
puts "Proxy smoke passed across #{bases.join(', ')}; labelled rows retained."
