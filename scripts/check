#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

docker compose config --quiet
(
  cd apps/api
  bundle exec rubocop
  bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error
  bin/rails zeitwerk:check
  # The live Compose stack uses Redis DB 0. Test auction IDs can overlap with
  # development IDs, so run projection specs against a separate Redis DB.
  export REDIS_URL="${TEST_REDIS_URL:-redis://127.0.0.1:${REDIS_PORT:-6379}/15}"
  RAILS_ENV=test bin/rails db:prepare
  RAILS_ENV=test bundle exec rspec
)
(
  cd apps/web
  npm run lint
  npm run format:check
  npm run typecheck
  npm test
  npm run build
)
