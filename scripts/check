#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -f .env ]]; then
  set -a
  # This optional local file is generated from .env.example and is not tracked.
  # shellcheck disable=SC1091
  source .env
  set +a
fi

docker compose config --quiet
(
  cd apps/api
  # Ten real concurrent command sessions plus the coordinator require the
  # same test pool budget as hosted CI; development defaults are smaller.
  export RAILS_MAX_THREADS=15 OTEL_ENABLED=false
  bundle exec rubocop
  bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error
  bin/bundler-audit
  bin/rails zeitwerk:check
  # The live Compose stack uses Redis DB 0. Test auction IDs can overlap with
  # development IDs, so run projection specs against a separate Redis DB.
  export REDIS_URL="${TEST_REDIS_URL:-redis://127.0.0.1:${REDIS_PORT:-6379}/15}"
  env RAILS_ENV=test bin/rails db:prepare
  env RAILS_ENV=test bundle exec rspec
)
(
  cd apps/web
  npm audit --audit-level=high
  npm run lint
  npm run format:check
  npm run typecheck
  npm test
  npm run build
)
